{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "gourmet-ai-bangalore",
  "builds": [
    {
      "src": "phase_8/api/*.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15,
        "includeFiles": [
          "phase_1/**",
          "phase_2/data/processed/**",
          "phase_3/**",
          "phase_4/**",
          "phase_5/**",
          "phase_6/**",
          "phase_7/**",
          "phase_8/**"
        ]
      }
    },
    {
      "src": "phase_6/static/**",
      "use": "@vercel/static"
    },
    {
      "src": "phase_6/templates/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/phase_6/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/api/recommendations",
      "dest": "/phase_8/api/recommendations.py",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/health",
      "dest": "/phase_8/api/health.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/metadata",
      "dest": "/phase_8/api/metadata.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "/phase_6/templates/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, If-None-Match"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "env": {
    "SERVERLESS_TIMEOUT_SECONDS": "15",
    "RESTAURANT_DATA_SOURCE": "local_parquet"
  }
}
