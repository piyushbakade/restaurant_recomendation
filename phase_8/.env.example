# ==============================================================================
# GourmetAI - Phase 8 Vercel Serverless Deployment Environment Template
# ==============================================================================
# Copy this file to .env in your project root or set these variables in the Vercel dashboard:
# Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Configuration (Google Gemini / Anthropic)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Database Configuration (Neon Serverless PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection pooled connection string with pgbouncer enabled:
DATABASE_URL=postgresql://username:password@ep-restaurant-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Data storage mode: "local_parquet" or "cloud_postgres"
RESTAURANT_DATA_SOURCE=local_parquet

# ------------------------------------------------------------------------------
# 3. Serverless Execution & Safeguards
# ------------------------------------------------------------------------------
VERCEL_ENV=development
SERVERLESS_TIMEOUT_SECONDS=15
ENABLE_ANTI_HALLUCINATION_GUARDRAILS=true
PORT=8000
HOST=127.0.0.1
