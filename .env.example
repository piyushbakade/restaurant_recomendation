# ==============================================================================
# GourmetAI - Bangalore Restaurant Recommendation Service
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to: .env
# 2. Fill in your secret keys below.
# 3. .env is excluded in .gitignore and will NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Configuration (Google Gemini / Anthropic)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Database Configuration (Cloud PostgreSQL / Local Fallback)
# ------------------------------------------------------------------------------
# Connection pooled connection string for Neon Serverless PostgreSQL or Supabase.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# If left blank, the application automatically uses the local high-speed parquet catalog.
#DATABASE_URL=postgresql://username:password@ep-restaurant-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Data storage mode: "local_parquet" (instant local execution) or "cloud_postgres" (Neon DB)
RESTAURANT_DATA_SOURCE=local_parquet

# ------------------------------------------------------------------------------
# 3. Serverless & Deployment Telemetry (Vercel)
# ------------------------------------------------------------------------------
# Vercel environment: "development", "preview", or "production"
VERCEL_ENV=development

# Serverless function execution timeout ceiling in seconds (per ARCHITECTURE.md line 327)
SERVERLESS_TIMEOUT_SECONDS=15

# Enable anti-hallucination closed-world candidate guardrails (default: true)
ENABLE_ANTI_HALLUCINATION_GUARDRAILS=true

# Local development server port
PORT=8000
HOST=127.0.0.1
